# Build before the office visit. Record the resulting image ID in pilot evidence.
# No credential, release directory or company data belongs in this image.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
RUN useradd --create-home --uid 1000 sandbox
USER sandbox
WORKDIR /workspace
CMD ["sleep", "infinity"]

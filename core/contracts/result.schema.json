{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent desk tool result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "status",
    "data",
    "evidence",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "succeeded",
        "unchanged",
        "no_record",
        "incomplete",
        "denied",
        "unavailable",
        "invalid_input",
        "failed",
        "unverified"
      ]
    },
    "data": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "check"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          },
          "range": {
            "type": "string"
          },
          "receipt": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "unchanged"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
